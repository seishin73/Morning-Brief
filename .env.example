# Copy to .env for local runs. Never commit the real file.
# In production these are set as environment variables on the host, not in a file.

# OPTIONAL. Without it the app still works: summaries fall back to the feed's own
# description, cleaned up (see summarise() in src/pipeline.js — `if (!key) return
# stories;`). Set it to get properly rewritten summaries instead.
ANTHROPIC_API_KEY=

# Optional: local dev port (defaults to the platform's value in production)
PORT=3000
