{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "server.js", "use": "@vercel/node" }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "referrer-policy": "no-referrer",
        "x-content-type-options": "nosniff"
      },
      "dest": "/server.js"
    }
  ]
}
